# 操作系统
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp
*.swo

# 依赖
node_modules/

# 日志
*.log
npm-debug.log*

# 临时文件
*.tmp
*.temp

# 环境变量与密钥
.env
.env.local
.env.*.local
# Wrangler 的本地变量文件：里面是真实的 JWT_SECRET，绝不能进版本库。
# 换机器/换人开发时各自生成一份即可（见 server/.env.example）。
.dev.vars
.dev.vars.*
# 迁移前自动备份的存档（core/migrate.ts 产生，属于用户本地数据）
*.backup.*

# 构建输出
dist/
build/

# Trae IDE
.trae/

# 工具自身目录
.mimocode/
.wrangler/
