{
  "name": "badminton-scoreboard-server",
  "version": "4.0.0",
  "private": true,
  "description": "羽毛球极速计分板 · 后端（Cloudflare Workers + D1）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-api.mjs",
    "db:init": "wrangler d1 execute badminton --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute badminton --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
